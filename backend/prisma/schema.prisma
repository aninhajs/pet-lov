generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  senha_hash       String
  tipo             TipoUsuario @default(admin)
  ativo            Boolean     @default(true)
  data_atualizacao DateTime
  data_criacao     DateTime    @default(now())
  endereco         String?
  nome             String
  telefone         String?
  pets_cadastrados Pet[]

  @@map("users")
}

model Pet {
  id                     String              @id @default(cuid())
  nome                   String
  tipo                   TipoPet
  idade                  String
  porte                  PortePet
  sexo                   SexoPet
  cor                    String
  peso                   Decimal?
  descricao              String
  castrado               Boolean             @default(false)
  vacinado               Boolean             @default(false)
  vermifugado            Boolean             @default(false)
  necessidades_especiais String?
  historia               String?
  status                 StatusPet           @default(disponivel)
  data_cadastro          DateTime            @default(now())
  data_atualizacao       DateTime            @updatedAt
  usuario_id             String
  localizacao            String?
  adoption_candidates    AdoptionCandidate[]
  adocoes                Adoption[]
  imagens                PetImage[]
  interesses             PetInterest[]
  usuario_cadastrou      User                @relation(fields: [usuario_id], references: [id])
  vacinas                Vaccine[]

  @@map("pets")
}

model PetImage {
  id           String   @id @default(cuid())
  pet_id       String
  url_imagem   String
  nome_arquivo String
  tamanho      Int?
  tipo_mime    String?
  principal    Boolean  @default(false)
  data_upload  DateTime @default(now())
  pet          Pet      @relation(fields: [pet_id], references: [id], onDelete: Cascade)

  @@map("pet_images")
}

model AdoptionCandidate {
  nome                        String?
  endereco                    String?
  celular_01                  String?
  celular_02                  String?
  cpf                         String        @id @default(cuid())
  data_nascimento             DateTime?
  perfil_social               String?
  profissao                   String?
  alguem_alergico             String?
  castrados_motivo            String?
  clinica_veterinario         String?
  como_levara_veterinario     String?
  como_organizaria_mudanca    String?
  comodo_dia                  String?
  conhece_doencas             String?
  criterios_alimentacao       String?
  devolveria_se_mudar         String?
  disposto_adaptacao          String?
  filhotes_ou_castrar         String?
  finalidade_animal           String?
  frequencia_passeios         String?
  frequencia_remedio_verme    String?
  frequencia_veterinario      String?
  ja_teve_tem_animais         String?
  local_dormir                String?
  marca_racao                 String?
  marca_racao_adotado         String?
  mora_em                     String?
  moradores_trabalham         String?
  motivo_perda_animais        String?
  normas_condominio_animais   String?
  passeios                    String?
  possui_na_residencia        String?
  possui_veiculo              String?
  preparado_responsabilidade  String?
  pretende_mudar_5_anos       String?
  proprietario_aceita_animais String?
  providencia_crescimento     String?
  quantia_mensal_cuidados     String?
  reacao_bagunca              String?
  reacao_choro_latido         String?
  reacao_doenca               String?
  reacao_mordida_arranho      String?
  reside_com_quantas_pessoas  String?
  responsavel_financeiro      String?
  responsavel_viagem          String?
  tem_criancas                String?
  tempo_preso                 String?
  tempo_sozinho               String?
  teve_filhotes               String?
  tipo_portao                 String?
  tipo_quintal_varanda        String?
  tipo_residencia             String?
  todos_aceitam_adocao        String?
  vacinados_quais             String?
  vacinas_que_dara            String?
  CEP                         String?
  Cidade                      String?
  Pet_ID                      String?
  pets                        Pet?          @relation(fields: [Pet_ID], references: [id], onDelete: Cascade)
  cep                         Adoption[]
  cidade                      PetInterest[]

  @@map("adoption_candidates")
}

model PetInterest {
  id                String            @id @default(cuid())
  candidato_id      String
  pet_id            String
  status            StatusInteresse   @default(interessado)
  data_interesse    DateTime          @default(now())
  data_avaliacao    DateTime?
  observacoes_admin String?
  candidato         AdoptionCandidate @relation(fields: [candidato_id], references: [cpf], onDelete: Cascade)
  pet               Pet               @relation(fields: [pet_id], references: [id], onDelete: Cascade)

  @@unique([candidato_id, pet_id])
  @@map("pet_interests")
}

model Adoption {
  id               String            @id @default(cuid())
  pet_id           String
  candidato_id     String
  data_adocao      DateTime          @default(now())
  observacoes      String?
  taxa_adocao      Decimal?
  status           StatusAdocao      @default(ativa)
  data_atualizacao DateTime          @updatedAt
  candidato        AdoptionCandidate @relation(fields: [candidato_id], references: [cpf])
  pet              Pet               @relation(fields: [pet_id], references: [id])

  @@map("adoptions")
}

model Vaccine {
  id               String    @id @default(cuid())
  pet_id           String
  nome_vacina      String
  data_aplicacao   DateTime
  data_revacina    DateTime?
  lote             String?
  fabricante       String?
  veterinario      String?
  observacoes      String?
  data_cadastro    DateTime  @default(now())
  data_atualizacao DateTime  @updatedAt
  pet              Pet       @relation(fields: [pet_id], references: [id], onDelete: Cascade)

  @@map("vaccines")
}

enum TipoPet {
  cao
  gato
  outros
}

enum PortePet {
  pequeno
  medio
  grande
}

enum SexoPet {
  macho
  femea
}

enum StatusPet {
  disponivel
  em_processo
  adotado
  indisponivel
}

enum TipoUsuario {
  admin
  comum
}

enum StatusCandidato {
  pendente
  aprovado
  rejeitado
}

enum StatusInteresse {
  interessado
  aprovado
  rejeitado
}

enum StatusAdocao {
  ativa
  cancelada
  devolvido
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model adopter {
  id_adopter BigInt    @id @default(autoincrement())
  name       String    @db.VarChar
  birth      DateTime? @db.Date
  address    String?
  CPF        String?   @db.VarChar
  number     BigInt?
  created_at DateTime? @default(dbgenerated("'2025-10-24 02:14:07.077035+00'::timestamp with time zone")) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ong_credencial {
  id_crecendial BigInt  @id @default(autoincrement())
  email         String  @unique @db.VarChar
  password      String? @db.VarChar
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pets {
  id_pet            BigInt              @id @default(autoincrement())
  pet_name          String              @db.VarChar
  pet_weigth        String?             @db.VarChar
  pet_description   String?
  pet_size          enum_size?
  pet_sex           enum_sex?
  pet_health_status enum_health_status?
  special_needs     String?
  pet_history       String?
  created_at        DateTime?           @default(dbgenerated("'2025-10-24 02:13:38.524599+00'::timestamp with time zone")) @db.Timestamptz(6)
}

enum enum_health_status {
  castrated
  vaccinated
  Wormed
}

enum enum_sex {
  male
  female
}

enum enum_size {
  small
  medium
  large
}
